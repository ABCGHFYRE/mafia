{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('host').val() === auth.uid",
        "host": { ".write": "auth != null && (!data.exists() || data.val() === auth.uid)" },
        "state": { ".write": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid" },
        "players": { "$uid": { ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/host').val() === auth.uid)" } }
      }
    },
    "secrets": {
      "$code": { "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid"
      } }
    },
    "actions": {
      "$code": {
        ".read": "auth != null && root.child('rooms/' + $code + '/host').val() === auth.uid",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    }
  }
}
